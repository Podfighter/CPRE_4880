<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="swplatform"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
swplatform
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="swplatform">
        <sdx:configuration sdx:name="swplatform"
                           sdx:displayName="swplatform"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>swplatform</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="swplatform/boot/swplatform.bif"
                            sdx:readme="swplatform/boot/generic.readme"
                            sdx:qemuArguments="swplatform/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="swplatform/boot/swplatform.bif"
                            sdx:readme="swplatform/boot/generic.readme"
                            sdx:qemuArguments="swplatform/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="swplatform/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="swplatform/standalone_domain/bspinclude/include"
                        sdx:bspConfig="swplatform/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
