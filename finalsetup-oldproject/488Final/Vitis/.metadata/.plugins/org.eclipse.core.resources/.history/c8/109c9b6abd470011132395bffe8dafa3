usleep(5);

}

void play(int samples){

	//base is 0x40410000...

	while(!(Xil_In32(0x40400004) & 0x00000002));
	XStatus gim = XAxiDma_SimpleTransfer(&Dmaplay,CT,0x1000 * samples,XAXIDMA_DMA_TO_DEVICE);
	if(gim != 0){exit(1);}
	usleep(5);




}
