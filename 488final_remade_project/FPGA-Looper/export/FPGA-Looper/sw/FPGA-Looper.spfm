<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="FPGA-Looper"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
FPGA-Looper
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="FPGA-Looper">
        <sdx:configuration sdx:name="FPGA-Looper"
                           sdx:displayName="FPGA-Looper"
                           sdx:defaultProcessorGroup="domain_ps7_cortexa9_0"
                           sdx:runtimes="cpp">
            <sdx:description>FPGA-Looper</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="FPGA-Looper/boot/FPGA-Looper.bif"
                            sdx:readme="FPGA-Looper/boot/generic.readme"
                            sdx:qemuArguments="FPGA-Looper/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="domain_ps7_cortexa9_0"
                            sdx:bif="FPGA-Looper/boot/FPGA-Looper.bif"
                            sdx:readme="FPGA-Looper/boot/generic.readme"
                            sdx:qemuArguments="FPGA-Looper/domain_ps7_cortexa9_0/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="domain_ps7_cortexa9_0"
                                sdx:displayName="domain_ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="FPGA-Looper/domain_ps7_cortexa9_0/bsplib/lib"
                        sdx:bspIncludePaths="FPGA-Looper/domain_ps7_cortexa9_0/bspinclude/include"
                        sdx:bspConfig="FPGA-Looper/domain_ps7_cortexa9_0/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
